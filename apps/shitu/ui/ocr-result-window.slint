import { Button, TextEdit } from "std-widgets.slint";
import { AppTheme, NativeFrameStyle } from "theme.slint";

export enum OcrResultStatus { ready, copied, recognition-failed, completed, copy-failed }

export component OcrResultWindow inherits Window {
    title: @tr("OCR 识别结果");
    icon: @image-url("icons/tray.svg");
    preferred-width: 520px;
    preferred-height: 360px;
    min-width: 380px;
    min-height: 260px;
    background: AppTheme.background;
    default-font-size: 12.07px;

    in-out property <string> result-text;
    in property <OcrResultStatus> status: ready;
    in property <string> error-details;
    // Keep translated bindings reactive even after a result has been shown.
    private property <string> status-text:
        root.status == OcrResultStatus.copied ? @tr("已复制全部文字")
        : root.status == OcrResultStatus.recognition-failed ? @tr("OCR 识别失败，错误详情已写入日志。")
        : root.status == OcrResultStatus.completed ? @tr("OCR 识别已完成。")
        : root.status == OcrResultStatus.copy-failed ? @tr("复制失败") + ": " + root.error-details
        : @tr("可选择文字，或复制全部内容。");
    out property <NativeFrameStyle> native-frame-style: AppTheme.native-frame-style;

    callback copy-text();
    callback close-result();
    callback native-frame-changed();

    changed native-frame-style => { root.native-frame-changed(); }

    FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.close-result();
                accept
            } else {
                reject
            }
        }
    }

    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        Text {
            text: @tr("识别结果");
            color: AppTheme.text;
            font-size: 14px;
            font-weight: 700;
            vertical-alignment: center;
        }

        result-editor := TextEdit {
            text <=> root.result-text;
            read-only: true;
            wrap: word-wrap;
            font-size: 13px;
        }

        HorizontalLayout {
            height: 30px;
            spacing: 6px;

            Text {
                text: root.status-text;
                color: AppTheme.muted-text;
                font-size: 13px;
                vertical-alignment: center;
                overflow: elide;
            }
            Rectangle { }
            Button {
                text: @tr("复制全部");
                primary: true;
                clicked => { root.copy-text(); }
            }
            Button {
                text: @tr("关闭");
                clicked => { root.close-result(); }
            }
        }
    }
}
