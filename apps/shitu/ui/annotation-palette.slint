        #ec5c66, #4a90e2, #31a36b, #f5c542, #f2994a, #9b51e0,
        #eb65a0, #19b5c5, #202124, #ffffff, #8b95a5, #9b6b43,
    ];
    out property <[string]> names: [
        @tr("红色"), @tr("蓝色"), @tr("绿色"), @tr("黄色"), @tr("橙色"), @tr("紫色"),
        @tr("粉色"), @tr("青色"), @tr("黑色"), @tr("白色"), @tr("灰色"), @tr("棕色"),
    ];
}
