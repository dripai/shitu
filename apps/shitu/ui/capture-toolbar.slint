import { ComboBox, SpinBox } from "std-widgets.slint";
import { AnnotationPalette } from "annotation-palette.slint";
import { AppTheme } from "theme.slint";

component ToolCell inherits Rectangle {
    in property <image> icon;
    in property <string> tip;
    in property <bool> selected: false;
    callback activated();

    width: 28px;
    height: 28px;
    border-radius: 3px;
    border-width: root.selected ? 1px : 0px;
    border-color: AppTheme.accent;
    background: root.selected ? AppTheme.selected : (touch.has-hover ? AppTheme.hover : transparent);
    accessible-role: button;
    accessible-label: root.tip;

    Image {
        x: 6px;
        y: 6px;
        width: 16px;
        height: 16px;
        source: root.icon;
        colorize: root.selected ? AppTheme.accent : AppTheme.text;
        image-fit: contain;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }
    }

    Tooltip { text: @markdown("\{root.tip}"); }
}

component ColorCell inherits Rectangle {
    in property <color> swatch-color;
    in property <string> tip;
    in property <bool> selected: false;
    callback activated();

    width: 24px;
    height: 28px;
    border-radius: 3px;
    background: touch.has-hover ? AppTheme.hover : transparent;
    accessible-role: button;
    accessible-label: root.tip;

    Rectangle {
        x: 4px;
        y: 6px;
        width: 16px;
        height: 16px;
        border-width: root.selected ? 2px : 1px;
        border-color: root.selected ? AppTheme.text : AppTheme.border;
        background: root.swatch-color;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }
    }

    Tooltip { text: @markdown("\{root.tip}"); }
}

export component CaptureToolbar inherits Rectangle {
    in property <bool> annotation-tools-visible: true;
    in property <bool> ocr-available: false;
    in property <bool> pin-action-visible: true;
    in property <bool> properties-above: false;
    in property <string> save-tip-override;
    in property <string> copy-tip-override;
    in property <string> ocr-tip-override;
    in property <string> cancel-tip: @tr("取消截图");
    in-out property <int> active-tool: 0;
    in-out property <int> color-index: 0;
    in-out property <int> stroke-radius: 2;
    in-out property <int> text-size: 20;
    in-out property <bool> dashed: false;
    property <[int]> stroke-radii: [1, 2, 3, 4, 6, 8, 12];
    property <[int]> font-sizes: [8, 12, 16, 20, 24, 32, 48, 64, 96];
    property <bool> tool-properties-visible: root.annotation-tools-visible
        && ((root.active-tool > 0 && root.active-tool < 5)
            || root.active-tool == 6 || root.active-tool == 7);
    property <bool> shape-tool: root.active-tool == 2 || root.active-tool == 7;
    property <length> calculated-width: root.annotation-tools-visible
        ? 402px + (root.ocr-available ? 30px : 0px) + (root.pin-action-visible ? 30px : 0px)
        : 96px + (root.ocr-available ? 30px : 0px) + (root.pin-action-visible ? 30px : 0px);
    out property <length> main-row-height: 38px;
    out property <length> expanded-height: 106px;
    property <length> calculated-height: root.tool-properties-visible
        ? root.expanded-height : root.main-row-height;
    property <length> main-row-offset: root.properties-above
        ? root.calculated-height - root.main-row-height : 0px;

    callback undo();
    callback redo();
    callback save-output();
    callback copy-output();
    callback recognize-text();
    callback pin-action();
    callback cancel-action();
    callback select-tool(int);
    callback select-color(int);
    callback select-width(int);
    callback select-text-size(int);
    callback select-dashed(bool);

    width: root.calculated-width;
    height: root.calculated-height;
    border-radius: 4px;
    border-width: 1px;
    border-color: AppTheme.border;
    background: AppTheme.card;

    HorizontalLayout {
        x: 4px;
        y: root.main-row-offset + 5px;
        width: root.width - 8px;
        height: 28px;
        spacing: 2px;
        alignment: center;

        if root.annotation-tools-visible: ToolCell {
            icon: @image-url("../src/icons/undo-2.svg");
            tip: @tr("撤销上一步操作");
            activated => { root.undo(); }
        }
        if root.annotation-tools-visible: ToolCell {
            icon: @image-url("../src/icons/redo-2.svg");
            tip: @tr("重做上一步操作");
            activated => { root.redo(); }
        }
        if root.annotation-tools-visible: Rectangle {
            width: 1px;
            height: 20px;
            background: AppTheme.divider;
        }

        if root.annotation-tools-visible: ToolCell {
            icon: @image-url("../src/icons/mouse-pointer.svg");
            tip: @tr("选择 / 编辑标注");
            selected: root.active-tool == 8;
            activated => {
                root.active-tool = root.active-tool == 8 ? 0 : 8;
                root.select-tool(root.active-tool);
            }
        }
        if root.annotation-tools-visible: ToolCell {
            icon: @image-url("../src/icons/pencil.svg");
            tip: @tr("画笔标注");
            selected: root.active-tool == 1;
            activated => {
                root.active-tool = root.active-tool == 1 ? 0 : 1;
                root.select-tool(root.active-tool);
            }
        }
        if root.annotation-tools-visible: ToolCell {
            icon: @image-url("../src/icons/square.svg");
            tip: @tr("绘制矩形");
            selected: root.active-tool == 2;
            activated => {
                root.active-tool = root.active-tool == 2 ? 0 : 2;
                root.select-tool(root.active-tool);
            }
        }
        if root.annotation-tools-visible: ToolCell {
            icon: @image-url("../src/icons/circle.svg");
            tip: @tr("绘制圆形 / 椭圆");
            selected: root.active-tool == 7;
            activated => {
                root.active-tool = root.active-tool == 7 ? 0 : 7;
                root.select-tool(root.active-tool);
            }
        }
        if root.annotation-tools-visible: ToolCell {
            icon: @image-url("../src/icons/arrow-up-right.svg");
            tip: @tr("绘制箭头");
            selected: root.active-tool == 3;
            activated => {
                root.active-tool = root.active-tool == 3 ? 0 : 3;
                root.select-tool(root.active-tool);
            }
        }
        if root.annotation-tools-visible: ToolCell {
            icon: @image-url("../src/icons/letter-t.svg");
            tip: @tr("添加文字");
            selected: root.active-tool == 4;
            activated => {
                root.active-tool = root.active-tool == 4 ? 0 : 4;
                root.select-tool(root.active-tool);
            }
        }
        if root.annotation-tools-visible: ToolCell {
            icon: @image-url("../src/icons/eraser.svg");
            tip: @tr("擦除标注");
            selected: root.active-tool == 5;
            activated => {
                root.active-tool = root.active-tool == 5 ? 0 : 5;
                root.select-tool(root.active-tool);
            }
        }
        if root.annotation-tools-visible: ToolCell {
            icon: @image-url("../src/icons/mosaic.svg");
            tip: @tr("添加马赛克");
            selected: root.active-tool == 6;
            activated => {
                root.active-tool = root.active-tool == 6 ? 0 : 6;
                root.select-tool(root.active-tool);
            }
        }
        if root.annotation-tools-visible: Rectangle {
            width: 1px;
            height: 20px;
            background: AppTheme.divider;
        }

        if root.ocr-available: ToolCell {
            icon: @image-url("../src/icons/scan-text.svg");
            tip: root.ocr-tip-override != ""
                ? root.ocr-tip-override
                : root.annotation-tools-visible ? @tr("识别选区文字") : @tr("识别图像文字");
            activated => { root.recognize-text(); }
        }
        if root.pin-action-visible: ToolCell {
            icon: @image-url("../src/icons/pin.svg");
            tip: @tr("将截图钉在屏幕上");
            activated => { root.pin-action(); }
        }
        ToolCell {
            icon: @image-url("../src/icons/x.svg");
            tip: root.cancel-tip;
            activated => { root.cancel-action(); }
        }
        ToolCell {
            icon: @image-url("../src/icons/save.svg");
            tip: root.save-tip-override != ""
                ? root.save-tip-override : @tr("保存截图到文件");
            activated => { root.save-output(); }
        }
        ToolCell {
            icon: @image-url("../src/icons/copy.svg");
            tip: root.copy-tip-override != ""
                ? root.copy-tip-override : @tr("复制截图到剪贴板");
            activated => { root.copy-output(); }
        }
    }

    if root.tool-properties-visible: HorizontalLayout {
        x: 4px;
        y: root.properties-above ? 2px : root.main-row-height;
        width: root.width - 8px;
        height: 66px;
        spacing: 8px;
        alignment: center;

        if root.active-tool != 6: VerticalLayout {
            width: 154px;
            height: 58px;
            spacing: 2px;

            HorizontalLayout {
                height: 28px;
                spacing: 2px;
                for index in [0, 1, 2, 3, 4, 5]: ColorCell {
                    swatch-color: AnnotationPalette.colors[index];
                    tip: AnnotationPalette.names[index];
                    selected: root.color-index == index;
                    activated => {
                        root.color-index = index;
                        root.select-color(index);
                    }
                }
            }
            HorizontalLayout {
                height: 28px;
                spacing: 2px;
                for index in [6, 7, 8, 9, 10, 11]: ColorCell {
                    swatch-color: AnnotationPalette.colors[index];
                    tip: AnnotationPalette.names[index];
                    selected: root.color-index == index;
                    activated => {
                        root.color-index = index;
                        root.select-color(index);
                    }
                }
            }
        }
        if root.active-tool != 6: Rectangle {
            width: 1px;
            height: 50px;
            background: AppTheme.divider;
        }
        VerticalLayout {
            width: 188px;
            height: root.shape-tool || root.active-tool == 4 ? 66px : 32px;
            spacing: 2px;
            alignment: center;

            if root.active-tool == 4: ComboBox {
                width: 188px;
                height: 32px;
                model: ["8", "12", "16", "20", "24", "32", "48", "64", "96"];
                // Leave presets unselected when the numeric editor has a custom size.
                current-index: root.text-size == 8 ? 0 : root.text-size == 12 ? 1
                    : root.text-size == 16 ? 2 : root.text-size == 20 ? 3
                    : root.text-size == 24 ? 4 : root.text-size == 32 ? 5
                    : root.text-size == 48 ? 6 : root.text-size == 64 ? 7
                    : root.text-size == 96 ? 8 : -1;
                accessible-label: @tr("文字大小");
                selected(value) => {
                    root.text-size = root.font-sizes[self.current-index];
                    root.select-text-size(root.text-size);
                }
            }

            if root.active-tool == 4: SpinBox {
                width: 188px;
                height: 32px;
                minimum: 8;
                maximum: 96;
                value <=> root.text-size;
                accessible-label: @tr("文字大小");
                edited(value) => { root.select-text-size(value); }
            }

            if root.active-tool != 4: ComboBox {
                width: 188px;
                height: 32px;
                // Mosaic values are the image-pixel brush diameters (radius * 2).
                model: root.active-tool == 6 ? ["20", "36", "60"]
                    : ["2", "4", "6", "8", "12", "16", "24"];
                current-index: root.active-tool == 6
                    ? (root.stroke-radius == 1 ? 0 : root.stroke-radius >= 4 ? 2 : 1)
                    : root.stroke-radius == 1 ? 0 : root.stroke-radius == 2 ? 1
                    : root.stroke-radius == 3 ? 2 : root.stroke-radius == 4 ? 3
                    : root.stroke-radius == 6 ? 4 : root.stroke-radius == 8 ? 5
                    : root.stroke-radius == 12 ? 6 : -1;
                accessible-label: root.active-tool == 6 ? @tr("马赛克大小") : @tr("线宽");
                selected(value) => {
                    root.stroke-radius = root.active-tool == 6
                        ? (self.current-index == 0 ? 1 : self.current-index == 2 ? 4 : 2)
                        : root.stroke-radii[self.current-index];
                    root.select-width(root.stroke-radius);
                }
            }

            if root.shape-tool: ComboBox {
                width: 188px;
                height: 32px;
                model: ["────────", "┄┄┄┄┄┄┄┄"];
                current-index: root.dashed ? 1 : 0;
                accessible-label: @tr("边框样式");
                selected(value) => {
                    root.dashed = self.current-index == 1;
                    root.select-dashed(root.dashed);
                }
            }
        }
    }
}
