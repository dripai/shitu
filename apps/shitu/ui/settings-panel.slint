import {
    Button, ComboBox, GroupBox, LineEdit, ScrollView, Slider, SpinBox, Switch, TabWidget
} from "std-widgets.slint";
import { AppTheme } from "theme.slint";

component FieldLabel inherits Text {
    width: 128px;
    color: AppTheme.muted-text;
    font-size: 13px;
    vertical-alignment: center;
    overflow: elide;
    Tooltip { text: @markdown("\{root.text}"); }
}

// Fluent GroupBox supplies the heading, layout and accessible grouping, but no
// rounded card background or shadow. This wrapper only adds those decorations.
component SettingsCard inherits Rectangle {
    in property <string> title;
    vertical-stretch: 0;
    border-width: 1px;
    border-color: AppTheme.border;
    border-radius: 10px;
    background: AppTheme.card;
    drop-shadow-offset-y: 2px;
    drop-shadow-blur: 8px;
    drop-shadow-color: AppTheme.shadow;

    VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-bottom: 14px;
        GroupBox {
            title: root.title;
            content-padding: 0px;
            VerticalLayout {
                spacing: 10px;
                Rectangle { height: 1px; background: AppTheme.divider; }
                @children
            }
        }
    }
}

// Native scrolling keeps controls reachable in a short window or at high DPI.
component SettingsPage inherits ScrollView {
    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
    viewport-width: root.visible-width;
    viewport-height: max(root.visible-height, page.min-height);

    page := VerticalLayout {
        width: root.viewport-width;
        height: self.min-height;
        padding: 12px;
        spacing: 12px;
        @children
    }
}

component PathActionButton inherits Rectangle {
    in property <string> text;
    callback activated();
    callback hover-changed(bool);

    width: 112px;
    height: 32px;
    border-width: 1px;
    border-color: AppTheme.border;
    border-radius: 4px;
    background: touch.pressed ? AppTheme.selected
        : touch.has-hover ? AppTheme.hover : AppTheme.card;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.activated(); }

    Text {
        text: root.text;
        color: AppTheme.text;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }
        changed has-hover => { root.hover-changed(self.has-hover); }
    }
}

component AboutInfoRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    height: 28px;
    spacing: 10px;

    Text {
        width: 80px;
        text: root.label;
        color: AppTheme.muted-text;
        font-size: 13px;
        vertical-alignment: center;
    }
    Text {
        text: root.value;
        color: AppTheme.text;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }
    Rectangle { }
}

// Slint 1.17 has no hyperlink widget. Retain the existing text link and URL API.
component AboutLinkRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <string> url;
    height: 28px;
    spacing: 10px;

    Text {
        width: 80px;
        text: root.label;
        color: AppTheme.muted-text;
        font-size: 13px;
        vertical-alignment: center;
    }
    Text {
        text: root.value;
        color: AppTheme.accent;
        font-size: 13px;
        vertical-alignment: center;
        accessible-role: button;
        accessible-label: root.label + " " + root.value;
        accessible-action-default => { Platform.open-url(root.url); }
        TouchArea {
            mouse-cursor: pointer;
            clicked => { Platform.open-url(root.url); }
        }
    }
    Rectangle { }
}

export component SettingsPanel inherits Rectangle {
    background: AppTheme.background;

    in-out property <int> current-tab: 0;
    in-out property <int> theme-mode: 0;
    in-out property <int> language-mode: 0;
    in-out property <bool> launch-at-startup: false;
    in-out property <bool> start-minimized: false;
    in-out property <int> image-format: 0;
    in-out property <int> jpeg-quality: 90;
    in-out property <string> save-directory;
    in-out property <string> filename-template;
    in-out property <bool> auto-save: false;
    in-out property <bool> save-notification: true;
    in-out property <int> pin-opacity: 100;
    in-out property <bool> pin-shadow: true;
    in-out property <bool> pin-always-on-top: true;
    in-out property <bool> pin-wheel-zoom: true;
    in-out property <int> pin-zoom-step: 15;
    in-out property <bool> pin-double-click-close: true;
    in-out property <string> hotkey-text;
    in property <int> hotkey-status: 0;
    in property <string> hotkey-status-tip;
    in property <string> version-text;
    in property <string> build-text;
    in property <string> log-path;
    in property <string> config-path;
    in property <bool> ocr-available: false;
    in property <string> ocr-status;
    in property <bool> system-ocr-available: false;
    in property <string> system-ocr-status;
    in property <bool> ai-ocr-available: false;
    in property <string> ai-ocr-status;
    in property <bool> ai-ocr-can-install: false;
    in-out property <int> ocr-engine: 0;
    in-out property <int> ocr-minimum-confidence: 60;

    callback apply-settings();
    callback capture();
    callback restore-defaults(int);
    callback choose-save-directory();
    callback open-save-directory();
    callback open-log-directory();
    callback open-config-directory();
    callback config-hint(bool);
    callback clear-hotkey();
    callback prepare-ai-ocr();
    callback preview-language(int);

    changed current-tab => { root.config-hint(false); }

    VerticalLayout {
        spacing: 0px;

        // Keep native text, click targets and accessible labels together.
        // TabWidget retains keyboard navigation and focus management.
        TabWidget {
            current-index <=> root.current-tab;
            vertical-stretch: 1;

            Tab {
                title: @tr("常规");
                SettingsPage {
                    SettingsCard {
                        title: @tr("应用");
                        HorizontalLayout {
                            height: 26px;
                            spacing: 16px;
                            Switch { text: @tr("开机启动"); checked <=> root.launch-at-startup; }
                            Switch {
                                text: @tr("启动最小化");
                                enabled: root.launch-at-startup;
                                checked <=> root.start-minimized;
                            }
                            Rectangle { }
                        }
                        HorizontalLayout {
                            height: 32px;
                            spacing: 10px;
                            FieldLabel { text: @tr("外观模式"); }
                            ComboBox {
                                model: [@tr("跟随系统"), @tr("浅色"), @tr("深色")];
                                current-index <=> root.theme-mode;
                            }
                        }
                        HorizontalLayout {
                            height: 32px;
                            spacing: 10px;
                            FieldLabel { text: @tr("界面语言"); }
                            ComboBox {
                                model: [@tr("跟随系统"), @tr("简体中文"), "English"];
                                current-index <=> root.language-mode;
                                selected(value) => { root.preview-language(root.language-mode); }
                            }
                        }
                    }
                    SettingsCard {
                        title: @tr("文件与诊断");
                        HorizontalLayout {
                            height: 32px;
                            spacing: 10px;
                            PathActionButton {
                                text: @tr("打开日志");
                                activated => { root.open-log-directory(); }
                            }
                            Text {
                                text: root.log-path;
                                color: AppTheme.muted-text;
                                font-size: 13px;
                                vertical-alignment: center;
                                overflow: elide;
                                Tooltip { text: @markdown("\{root.log-path}"); }
                            }
                        }
                        HorizontalLayout {
                            height: 32px;
                            spacing: 10px;
                            PathActionButton {
                                text: @tr("打开配置");
                                activated => { root.open-config-directory(); }
                                hover-changed(hovered) => { root.config-hint(hovered); }
                            }
                            Text {
                                text: root.config-path;
                                color: AppTheme.muted-text;
                                font-size: 13px;
                                vertical-alignment: center;
                                overflow: elide;
                                Tooltip { text: @markdown("\{root.config-path}"); }
                            }
                        }
                    }
                }
            }

            Tab {
                title: @tr("截图");
                SettingsPage {
                    SettingsCard {
                        title: @tr("输出");
                        HorizontalLayout {
                            height: 32px;
                            spacing: 10px;
                            FieldLabel { text: @tr("图像格式"); }
                            ComboBox {
                                width: 120px;
                                model: ["PNG", "JPEG"];
                                current-index <=> root.image-format;
                            }
                            Rectangle { }
                        }
                        HorizontalLayout {
                            height: 32px;
                            spacing: 10px;
                            FieldLabel { text: @tr("质量"); }
                            if root.image-format == 0: Text {
                                text: @tr("无损");
                                color: AppTheme.text;
                                font-size: 13px;
                                vertical-alignment: center;
                            }
                            if root.image-format == 1: HorizontalLayout {
                                spacing: 8px;
                                horizontal-stretch: 1;
                                TouchArea {
                                    horizontal-stretch: 1;
                                    Slider {
                                        width: parent.width;
                                        height: parent.height;
                                        value: root.jpeg-quality;
                                        minimum: 1;
                                        maximum: 100;
                                        step: 1;
                                        changed(value) => { root.jpeg-quality = Math.round(value); }
                                    }
                                    scroll-event(event) => {
                                        if event.delta-y < 0 {
                                            root.jpeg-quality = Math.min(100, root.jpeg-quality + 1);
                                        } else if event.delta-y > 0 {
                                            root.jpeg-quality = Math.max(1, root.jpeg-quality - 1);
                                        }
                                        accept
                                    }
                                }
                                Text {
                                    width: 36px;
                                    text: "\{root.jpeg-quality}";
                                    color: AppTheme.text;
                                    font-size: 13px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        HorizontalLayout {
                            height: 32px;
                            spacing: 10px;
                            FieldLabel { text: @tr("保存目录"); }
                            LineEdit { text <=> root.save-directory; }
                        }
                        HorizontalLayout {
                            height: 32px;
                            spacing: 10px;
                            Rectangle { width: 128px; }
                            Button { text: @tr("选择..."); clicked => { root.choose-save-directory(); } }
                            Button { text: @tr("打开目录"); clicked => { root.open-save-directory(); } }
                            Rectangle { }
                        }
                        HorizontalLayout {
                            height: 32px;
                            spacing: 10px;
                            FieldLabel { text: @tr("文件名模板"); }
                            LineEdit { text <=> root.filename-template; }
                        }
                        Switch {
                            text: @tr("自动保存（执行复制或钉住时同时保存）");
                            checked <=> root.auto-save;
                        }
                        Switch { text: @tr("显示保存结果"); checked <=> root.save-notification; }
                    }
                }
            }

            Tab {
                title: "OCR";
                SettingsPage {
                    SettingsCard {
                        title: @tr("识别引擎");
                        HorizontalLayout {
                            height: 32px;
                            spacing: 10px;
                            FieldLabel { text: @tr("默认引擎"); }
                            ComboBox {
                                model: [@tr("兼容系统 OCR"), @tr("Windows AI OCR（增强）")];
                                current-index <=> root.ocr-engine;
                            }
                        }
                        HorizontalLayout {
                            height: 28px;
                            spacing: 10px;
                            FieldLabel { text: @tr("兼容 OCR"); }
                            Text {
                                text: root.system-ocr-status;
                                color: root.system-ocr-available ? AppTheme.success : AppTheme.error;
                                font-size: 13px;
                                vertical-alignment: center;
                                overflow: elide;
                                Tooltip { text: @markdown("\{root.system-ocr-status}"); }
                            }
                        }
                        HorizontalLayout {
                            height: 32px;
                            spacing: 10px;
                            FieldLabel { text: @tr("增强 OCR"); }
                            Text {
                                text: root.ai-ocr-status;
                                color: root.ai-ocr-available ? AppTheme.success : AppTheme.error;
                                font-size: 13px;
                                vertical-alignment: center;
                                overflow: elide;
                                Tooltip { text: @markdown("\{root.ai-ocr-status}"); }
                            }
                            if root.ai-ocr-can-install: Button {
                                text: @tr("安装模型");
                                clicked => { root.prepare-ai-ocr(); }
                            }
                        }
                    }
                    SettingsCard {
                        title: @tr("增强 OCR 输出");
                        HorizontalLayout {
                            height: 32px;
                            spacing: 10px;
                            FieldLabel { text: @tr("最低置信度"); }
                            SpinBox {
                                width: 100px;
                                enabled: root.ocr-engine == 1 && root.ai-ocr-available;
                                value <=> root.ocr-minimum-confidence;
                                minimum: 0;
                                maximum: 100;
                            }
                            Text { text: "%"; color: AppTheme.muted-text; vertical-alignment: center; }
                            Rectangle { }
                        }
                        Text {
                            text: @tr("仅过滤 Windows AI OCR 返回的低置信度词语。");
                            color: AppTheme.muted-text;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            Tab {
                title: @tr("钉住");
                SettingsPage {
                    SettingsCard {
                        title: @tr("新建钉住窗口");
                        HorizontalLayout {
                            height: 32px;
                            spacing: 10px;
                            FieldLabel { text: @tr("默认不透明度"); }
                            SpinBox { width: 100px; value <=> root.pin-opacity; minimum: 25; maximum: 100; }
                            Text { text: "%"; color: AppTheme.muted-text; vertical-alignment: center; }
                            Rectangle { }
                        }
                        Switch { text: @tr("窗口阴影"); checked <=> root.pin-shadow; }
                        Switch { text: @tr("始终置顶"); checked <=> root.pin-always-on-top; }
                        Switch { text: @tr("启用滚轮缩放"); checked <=> root.pin-wheel-zoom; }
                        HorizontalLayout {
                            height: 32px;
                            spacing: 10px;
                            FieldLabel { text: @tr("缩放步长"); }
                            SpinBox {
                                width: 100px;
                                enabled: root.pin-wheel-zoom;
                                value <=> root.pin-zoom-step;
                                minimum: 5;
                                maximum: 100;
                            }
                            Text { text: "%"; color: AppTheme.muted-text; vertical-alignment: center; }
                            Rectangle { }
                        }
                        Switch { text: @tr("双击关闭"); checked <=> root.pin-double-click-close; }
                    }
                }
            }

            Tab {
                title: @tr("快捷键");
                SettingsPage {
                    SettingsCard {
                        title: @tr("全局快捷键");
                        HorizontalLayout {
                            height: 32px;
                            spacing: 8px;
                            FieldLabel { text: @tr("区域截图"); }
                            LineEdit {
                                horizontal-stretch: 1;
                                text <=> root.hotkey-text;
                                placeholder-text: @tr("默认 Ctrl+Alt+C；留空则关闭");
                            }
                            Button { text: @tr("清除"); clicked => { root.clear-hotkey(); } }
                            if root.hotkey-status > 0: Rectangle {
                                width: 22px;
                                height: 22px;
                                border-radius: 11px;
                                background: root.hotkey-status == 1 ? AppTheme.success : AppTheme.error;
                                Text {
                                    text: root.hotkey-status == 1 ? "√" : "!";
                                    color: AppTheme.dark ? #191d25 : #ffffff;
                                    font-size: 15px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                Tooltip { text: @markdown("\{root.hotkey-status-tip}"); }
                            }
                        }
                        if root.hotkey-status != 1: Text {
                            text: root.hotkey-status == 0
                                ? @tr("未设置时不会注册任何全局快捷键。") : root.hotkey-status-tip;
                            color: AppTheme.muted-text;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            Tab {
                title: @tr("关于");
                SettingsPage {
                    SettingsCard {
                        title: @tr("拾图");
                        HorizontalLayout {
                            height: 56px;
                            spacing: 12px;
                            Image { width: 44px; height: 44px; source: @image-url("icons/tray.svg"); image-fit: contain; }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("拾图"); color: AppTheme.text; font-size: 20px; font-weight: 700; }
                                Text { text: root.version-text; color: AppTheme.muted-text; font-size: 13px; }
                            }
                            Rectangle { }
                        }
                        Text {
                            text: @tr("一款轻量、便捷的截图、标注与钉图工具。");
                            color: AppTheme.muted-text;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                        Text {
                            text: root.build-text;
                            color: AppTheme.muted-text;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                        AboutInfoRow { label: @tr("作者："); value: "logic"; }
                        AboutLinkRow { label: "Twitter:"; value: "@wz220321"; url: "https://x.com/wz220321"; }
                        AboutLinkRow { label: "GitHub:"; value: "dripai/shitu"; url: "https://github.com/dripai/shitu"; }
                        Text {
                            text: @tr("使用 Rust 与 Slint 构建 · © 2026");
                            color: AppTheme.muted-text;
                            font-size: 13px;
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            padding-top: 12px;
            padding-left: 12px;
            padding-right: 12px;
            spacing: 8px;
            Button {
                text: @tr("开始截图");
                primary: AppTheme.dark;
                clicked => { root.capture(); }
            }
            Rectangle { }
            if root.current-tab != 5: Button {
                text: @tr("恢复默认");
                clicked => { root.restore-defaults(root.current-tab); }
            }
            if root.current-tab != 5: Button {
                text: @tr("保存");
                primary: true;
                clicked => { root.apply-settings(); }
            }
        }
    }
}
