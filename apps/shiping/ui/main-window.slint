// Slint 1.17 的原生 Button 固定为横向图标与文字，无法表达参考设计需要的
// 圆形图标或数值和紧凑选中态。这个组件只补足视觉结构，点击、
// 键盘、悬浮提示与可访问语义继续使用 Slint 原生 TouchArea、FocusScope、
// Tooltip 和 accessible-* 属性。
component CapsuleAction {
    in property <string> label;
    in property <string> accessible-name: root.label;
    in property <string> tooltip-text: root.accessible-name;
    in property <string> icon-path;
    in property <string> icon-text;
    in property <bool> icon-filled: false;
    in property <bool> icon-stroked: true;
    in property <bool> has-menu: false;
    in property <bool> checked: false;
    in property <bool> checkable: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    in property <string> footer-text;
    in property <color> footer-color: #ff858e;
    out property <bool> has-hover <=> touch-area.has-hover;

    callback clicked();

    width: 46px;
    height: 57px;
    opacity: root.enabled ? 1 : 0.38;
    forward-focus: focus-scope;
    accessible-role: button;
    accessible-label: root.accessible-name;
    accessible-enabled: root.enabled;
    accessible-checkable: root.checkable;
    accessible-checked: root.checked;
    accessible-action-default => {
        if root.enabled { root.clicked(); }
    }

    VerticalLayout {
        spacing: 4px;
        alignment: center;

        icon-background := Rectangle {
            width: 34px;
            height: 34px;
            border-radius: 17px;
            border-width: 1px;
            border-color: focus-scope.has-focus
                ? #f14f5d
                : root.danger ? #f14f5d : root.checked ? #687487 : #414957;
            background: root.danger
                ? (touch-area.has-hover ? #df4351 : #f14f5d)
                : root.checked
                    ? (touch-area.has-hover ? #3c4656 : #323a48)
                    : (touch-area.has-hover ? #303744 : #252b36);

            animate background, border-color { duration: 120ms; }

            if root.icon-text == "": Path {
                x: 8.5px;
                y: 8.5px;
                width: 17px;
                height: 17px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: root.icon-path;
                fill: root.icon-filled ? white : transparent;
                stroke: root.icon-stroked ? white : transparent;
                stroke-width: 1.5px;
                stroke-line-cap: round;
                stroke-line-join: round;
            }

            if root.icon-text != "": Text {
                width: parent.width;
                height: parent.height;
                text: root.icon-text;
                color: white;
                font-size: root.icon-text == "1080" ? 9px : 11px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            if root.has-menu && root.icon-text == "": Path {
                x: 23px;
                y: 24px;
                width: 7px;
                height: 5px;
                viewbox-width: 7;
                viewbox-height: 5;
                commands: "M1 1 L3.5 3.5 L6 1";
                fill: transparent;
                stroke: #b2bac6;
                stroke-width: 1.2px;
                stroke-line-cap: round;
                stroke-line-join: round;
            }
        }

        if root.footer-text != "": Text {
            height: 14px;
            text: root.footer-text;
            color: root.footer-color;
            font-size: 12px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    touch-area := TouchArea {
        // Keep hit-testing active while the action is disabled so the window's
        // background drag layer cannot start a move gesture over a visible control.
        clicked => { if root.enabled { root.clicked(); } }
    }

    focus-scope := FocusScope {
        x: 0px;
        width: 0px;
        enabled: root.enabled;

        key-pressed(event) => {
            if event.text == " " || event.text == "\n" {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    Tooltip {
        text: @markdown("\{root.tooltip-text}");
    }
}

// Discrete choices use Slint's native menu abstraction. The backend decides whether the menu
// is platform-native or Slint-rendered, while keyboard navigation and dismissal stay portable.
component ChoiceAction {
    in property <string> label;
    in property <string> accessible-name: root.label;
    in property <string> icon-path;
    in property <string> icon-text;
    in property <bool> icon-filled: false;
    in property <bool> checked: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    in property <bool> menu-enabled: true;
    in property <int> selected-index: 0;
    in property <int> option-count: 3;
    in property <string> option-0;
    in property <string> option-1;
    in property <string> option-2;
    in property <string> option-3;
    out property <bool> has-hover <=> action.has-hover;

    callback clicked();
    callback selected(int);

    width: 46px;
    height: 57px;

    action := CapsuleAction {
        label: root.label;
        accessible-name: root.accessible-name;
        icon-path: root.icon-path;
        icon-text: root.icon-text;
        icon-filled: root.icon-filled;
        has-menu: root.menu-enabled;
        checked: root.checked;
        danger: root.danger;
        enabled: root.enabled;
        clicked => {
            if root.menu-enabled {
                choice-menu.show({ x: 0px, y: root.height });
            } else {
                root.clicked();
            }
        }
    }

    choice-menu := ContextMenuArea {
        enabled: root.enabled && root.menu-enabled;

        Menu {
            MenuItem {
                title: root.option-0;
                checkable: true;
                checked: root.selected-index == 0;
                activated => { root.selected(0); }
            }
            MenuItem {
                title: root.option-1;
                checkable: true;
                checked: root.selected-index == 1;
                activated => { root.selected(1); }
            }
            MenuItem {
                title: root.option-2;
                checkable: true;
                checked: root.selected-index == 2;
                activated => { root.selected(2); }
            }
            if root.option-count > 3: MenuItem {
                title: root.option-3;
                checkable: true;
                checked: root.selected-index == 3;
                activated => { root.selected(3); }
            }
        }
    }
}

// Screen selection is a dynamic submenu because monitor count and geometry can change at runtime.
// Slint's native Menu/MenuItem model keeps keyboard navigation and platform menu behavior intact.
component RangeAction {
    in property <string> label;
    in property <string> accessible-name: root.label;
    in property <string> icon-path;
    in property <bool> icon-filled: false;
    in property <bool> checked: false;
    in property <bool> enabled: true;
    in property <bool> menu-enabled: true;
    in property <int> source-mode: 0;
    in property <[string]> screen-options;
    in property <int> selected-screen-index: 0;
    out property <bool> has-hover <=> action.has-hover;

    callback clicked();
    callback refresh-screens();
    callback screen-selected(int);
    callback mode-selected(int);

    width: 46px;
    height: 57px;

    action := CapsuleAction {
        label: root.label;
        accessible-name: root.accessible-name;
        icon-path: root.icon-path;
        icon-filled: root.icon-filled;
        has-menu: root.menu-enabled;
        checked: root.checked;
        enabled: root.enabled;
        clicked => {
            if root.menu-enabled {
                root.refresh-screens();
                range-menu.show({ x: 0px, y: root.height });
            } else {
                root.clicked();
            }
        }
    }

    range-menu := ContextMenuArea {
        enabled: root.enabled && root.menu-enabled;

        Menu {
            Menu {
                title: @tr("屏幕");
                enabled: root.screen-options.length > 0;

                for screen[index] in root.screen-options: MenuItem {
                    title: screen;
                    checkable: true;
                    checked: root.source-mode == 0 && root.selected-screen-index == index;
                    activated => { root.screen-selected(index); }
                }
            }
            MenuItem {
                title: @tr("窗口");
                checkable: true;
                checked: root.source-mode == 1;
                activated => { root.mode-selected(1); }
            }
            MenuItem {
                title: @tr("区域");
                checkable: true;
                checked: root.source-mode == 2;
                activated => { root.mode-selected(2); }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: @tr("拾屏");
    icon: @image-url("icons/tray.svg");
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 13px;
    width: root.settings-collapsed ? 474px : 674px;
    height: 95px;
    background: transparent;
    no-frame: true;
    always-on-top: root.recording-active;

    in-out property <int> source-mode: 0;
    in-out property <int> quality-preset: 2;
    in-out property <int> frame-rate: 0;
    in-out property <int> output-format: 0;
    in-out property <bool> system-audio: true;
    in-out property <bool> microphone: false;
    in property <bool> system-audio-available: true;
    in property <bool> microphone-available: true;
    in-out property <bool> show-cursor: true;
    in-out property <bool> highlight-clicks: false;
    in-out property <int> countdown-seconds: 3;
    in-out property <bool> auto-minimize-after-start: false;
    in property <string> start-shortcut-label: "F10";
    in property <string> pause-shortcut-label: "F11";
    in property <string> stop-shortcut-label: "F12";
    in property <[string]> screen-options;
    in-out property <int> selected-screen-index: 0;
    in-out property <string> selected-screen-label: @tr("主显示器");
    in-out property <string> save-directory: "视频\\ShiPing";
    in-out property <int> recording-state: 0;
    in property <string> elapsed-text: "00:00:00";
    in property <string> output-file-name: "";
    in-out property <string> status-text: "";
    in-out property <int> status-level: 0;

    private property <bool> recording-active: root.recording-state == 1 || root.recording-state == 2;
    private property <bool> recording-busy: root.recording-active || root.recording-state == 3;
    private property <bool> settings-collapsed: root.recording-state == 1;
    private property <string> source-label: root.source-mode == 0
        ? root.selected-screen-label
        : root.source-mode == 1 ? @tr("窗口") : @tr("区域");
    private property <string> quality-label: root.quality-preset == 0
        ? @tr("自动")
        : root.quality-preset == 1 ? "720p" : root.quality-preset == 2 ? "1080p" : @tr("原始");
    private property <string> format-label: root.output-format == 0 ? "MP4" : "GIF";
    private property <string> frame-label: root.output-format == 0
        ? (root.frame-rate == 0 ? "30 FPS" : "60 FPS")
        : (root.frame-rate == 0 ? "10 FPS" : "20 FPS");
    private property <string> config-summary: root.source-label + "  ·  " + root.format-label
        + "  ·  " + root.quality-label + "  ·  " + root.frame-label;
    private property <string> detail-text: root.recording-state == 3
        ? root.status-text
        : root.recording-state == 1
        ? @tr("录制中") + "  ·  " + root.config-summary
        : root.recording-state == 2
            ? @tr("已暂停") + "  ·  " + root.config-summary
            : root.status-text == "" ? root.config-summary : root.status-text;

    animate width { duration: 180ms; easing: ease-in-out; }

    callback start-recording();
    callback pause-recording();
    callback stop-recording();
    callback begin-window-drag();
    callback choose-source();
    callback choose-output-directory();
    callback open-output-directory();
    callback open-output-file();
    callback quit-application();
    callback system-audio-changed(bool);
    callback microphone-changed(bool);
    callback show-cursor-changed(bool);
    callback highlight-clicks-changed(bool);
    callback countdown-changed(int);
    callback auto-minimize-after-start-changed(bool);
    callback open-preferences();
    callback refresh-screens();
    callback screen-selected(int);

    Rectangle {
        x: 5px;
        y: 5px;
        width: parent.width - 10px;
        height: parent.height - 10px;
        border-radius: 17px;
        border-width: 1px;
        border-color: #495260;
        background: #1a1f29;
        drop-shadow-offset-y: 2px;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000040;

        // This layer sits behind every interactive control. It turns every remaining
        // non-interactive area into a window drag surface without stealing button input.
        TouchArea {
            mouse-cursor: move;

            pointer-event(event) => {
                if event.kind == PointerEventKind.down
                        && event.button == PointerEventButton.left
                        && !range-action.has-hover
                        && !quality-action.has-hover
                        && !fps-action.has-hover
                        && !system-audio-action.has-hover
                        && !microphone-action.has-hover
                        && !record-action.has-hover
                        && !output-touch.has-hover {
                    root.begin-window-drag();
                }
            }
        }

        HorizontalLayout {
            padding-left: 26px;
            padding-right: 2px;
            padding-top: 14px;
            padding-bottom: 14px;
            spacing: 5.5px;

            Rectangle {
                width: 60px;
                height: 57px;
                background: transparent;

                Rectangle {
                    x: 2px;
                    y: 6.5px;
                    width: 44px;
                    height: 44px;
                    background: transparent;

                    Path {
                        width: 44px;
                        height: 44px;
                        viewbox-x: 3;
                        viewbox-y: 3;
                        viewbox-width: 18;
                        viewbox-height: 18;
                        commands: "M9 4 H4 V9 M15 4 H20 V9 M20 15 V20 H15 M9 20 H4 V15";
                        fill: transparent;
                        stroke: #e8ebf0;
                        stroke-width: 2px;
                        stroke-line-cap: round;
                        stroke-line-join: round;
                    }

                    Rectangle {
                        x: 16px;
                        y: 16px;
                        width: 12px;
                        height: 12px;
                        border-radius: 6px;
                        background: #f14f5d;
                    }
                }

            }

            VerticalLayout {
                width: 209.5px;
                height: 57px;
                spacing: 0px;

                Text {
                    height: 40px;
                    text: root.elapsed-text;
                    color: white;
                    font-size: 31px;
                    font-weight: 600;
                    letter-spacing: 0.65px;
                    vertical-alignment: center;
                }

                Rectangle {
                    height: 16px;
                    background: transparent;

                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: root.detail-text;
                        color: root.status-level == 2 ? #ff858e : root.output-file-name != "" ? #9fc4ff : #8f98a7;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    output-touch := TouchArea {
                        enabled: root.output-file-name != "" && root.recording-state == 0;
                        mouse-cursor: pointer;
                        clicked => { root.open-output-file(); }
                    }
                }
            }

            Rectangle {
                width: 1px;
                height: 46px;
                background: #343b47;
            }

            Rectangle {
                width: 12px;
                height: 1px;
                background: transparent;
            }

            range-action := RangeAction {
                label: root.recording-state == 1
                    ? @tr("暂停") : root.recording-state == 2 ? @tr("继续") : @tr("范围");
                accessible-name: root.recording-state == 1
                    ? @tr("暂停录制")
                        + (root.pause-shortcut-label == "" ? "" : " (" + root.pause-shortcut-label + ")")
                    : root.recording-state == 2
                        ? @tr("继续录制")
                            + (root.pause-shortcut-label == "" ? "" : " (" + root.pause-shortcut-label + ")")
                        : @tr("录制范围：{}", root.source-label);
                icon-path: root.recording-state == 1
                    ? "M8 6 H11 V18 H8 Z M13 6 H16 V18 H13 Z"
                    : root.recording-state == 2
                        ? "M8 5 L19 12 L8 19 Z"
                        : "M3 9 V3 H9 M15 3 H21 V9 M21 15 V21 H15 M9 21 H3 V15";
                icon-filled: root.recording-active;
                menu-enabled: !root.recording-active;
                checked: root.recording-state == 2 || (!root.recording-active && root.source-mode != 0);
                enabled: root.recording-state != 3;
                source-mode: root.source-mode;
                screen-options: root.screen-options;
                selected-screen-index: root.selected-screen-index;
                clicked => { root.pause-recording(); }
                refresh-screens => { root.refresh-screens(); }
                screen-selected(index) => { root.screen-selected(index); }
                mode-selected(index) => {
                    root.source-mode = index;
                    root.choose-source();
                }
            }

            Rectangle {
                width: root.settings-collapsed ? 0px : 200.5px;
                height: 57px;
                opacity: root.settings-collapsed ? 0 : 1;
                clip: true;

                animate width, opacity { duration: 180ms; easing: ease-in-out; }

                HorizontalLayout {
                    spacing: 5.5px;

                    quality-action := ChoiceAction {
                        label: root.quality-label;
                        accessible-name: @tr("清晰度：{}", root.quality-label);
                        icon-text: root.quality-preset == 0
                            ? "A" : root.quality-preset == 1 ? "720"
                            : root.quality-preset == 2 ? "1080" : "1:1";
                        enabled: !root.recording-busy;
                        selected-index: root.quality-preset;
                        option-count: 4;
                        option-0: @tr("自动");
                        option-1: "720p";
                        option-2: "1080p";
                        option-3: @tr("原始分辨率");
                        selected(index) => { root.quality-preset = index; }
                    }

                    fps-action := CapsuleAction {
                        label: root.frame-label;
                        accessible-name: @tr("帧率：{}", root.frame-label);
                        icon-text: root.output-format == 0
                            ? (root.frame-rate == 0 ? "30" : "60")
                            : (root.frame-rate == 0 ? "10" : "20");
                        enabled: !root.recording-busy;
                        clicked => { root.frame-rate = Math.mod(root.frame-rate + 1, 2); }
                    }

                    // Microsoft Fluent System Icons 24px Regular, MIT licensed.
                    // See ui/icons/FLUENT_SYSTEM_ICONS_LICENSE.
                    system-audio-action := CapsuleAction {
                        label: @tr("系统声");
                        accessible-name: root.system-audio
                            ? @tr("系统声音：开启") : @tr("系统声音：关闭");
                        icon-path: root.system-audio
                            ? "M15 4.24951C15 3.17089 13.7255 2.59866 12.9195 3.31534L8.42794 7.30861C8.29065 7.43067 8.11333 7.4981 7.92961 7.4981H4.25C3.00736 7.4981 2 8.50546 2 9.7481V14.246C2 15.4886 3.00736 16.496 4.25 16.496H7.92956C8.11329 16.496 8.29063 16.5634 8.42793 16.6855L12.9194 20.6792C13.7255 21.396 15 20.8238 15 19.7451V4.24951ZM9.4246 8.42962L13.5 4.8063V19.1883L9.42465 15.5646C9.01275 15.1983 8.48074 14.996 7.92956 14.996H4.25C3.83579 14.996 3.5 14.6602 3.5 14.246V9.7481C3.5 9.33388 3.83579 8.9981 4.25 8.9981H7.92961C8.48075 8.9981 9.01272 8.79581 9.4246 8.42962ZM18.9916 5.89684C19.3244 5.6503 19.7941 5.72028 20.0407 6.05313C21.2717 7.71521 22 9.77341 22 11.9995C22 14.2256 21.2717 16.2838 20.0407 17.9459C19.7941 18.2788 19.3244 18.3488 18.9916 18.1022C18.6587 17.8557 18.5888 17.386 18.8353 17.0531C19.8815 15.6406 20.5 13.8934 20.5 11.9995C20.5 10.1057 19.8815 8.35848 18.8353 6.94592C18.5888 6.61307 18.6587 6.14338 18.9916 5.89684ZM17.143 8.36884C17.5072 8.17165 17.9624 8.30709 18.1596 8.67135C18.6958 9.66196 19 10.7963 19 11.9995C19 13.2027 18.6958 14.3371 18.1596 15.3277C17.9624 15.6919 17.5072 15.8274 17.143 15.6302C16.7787 15.433 16.6432 14.9778 16.8404 14.6136C17.2609 13.8368 17.5 12.9472 17.5 11.9995C17.5 11.0518 17.2609 10.1622 16.8404 9.38544C16.6432 9.02118 16.7787 8.56603 17.143 8.36884Z"
                            : "M3.28034 2.21968C2.98745 1.92678 2.51257 1.92677 2.21968 2.21966C1.92678 2.51255 1.92677 2.98743 2.21966 3.28032L6.43782 7.49856H4.25C3.00736 7.49856 2 8.50592 2 9.74856V14.2465C2 15.4891 3.00736 16.4965 4.25 16.4965H7.92956C8.11329 16.4965 8.29063 16.5639 8.42793 16.686L12.9194 20.6797C13.7255 21.3965 15 20.8242 15 19.7456V16.0609L20.7194 21.7805C21.0123 22.0734 21.4872 22.0734 21.7801 21.7805C22.073 21.4876 22.073 21.0127 21.7801 20.7198L3.28034 2.21968ZM13.5 14.5609V19.1888L9.42465 15.565C9.01275 15.1988 8.48074 14.9965 7.92956 14.9965H4.25C3.83579 14.9965 3.5 14.6607 3.5 14.2465V9.74856C3.5 9.33435 3.83579 8.99856 4.25 8.99856H7.92961C7.93233 8.99856 7.93505 8.99856 7.93777 8.99855L13.5 14.5609ZM13.5 4.80677V10.3182L15 11.8182V4.24998C15 3.17136 13.7255 2.59913 12.9195 3.3158L9.52003 6.33813L10.5825 7.40062L13.5 4.80677ZM17.141 13.9592L18.279 15.0973C18.7408 14.1628 19 13.1107 19 12C19 10.7968 18.6958 9.66243 18.1596 8.67182C17.9624 8.30755 17.5072 8.17211 17.143 8.36931C16.7787 8.5665 16.6432 9.02165 16.8404 9.38591C17.2609 10.1627 17.5 11.0523 17.5 12C17.5 12.691 17.3729 13.3512 17.141 13.9592ZM19.3881 16.2064L20.4815 17.2998C21.4437 15.7631 22 13.9457 22 12C22 9.77388 21.2717 7.71568 20.0407 6.0536C19.7941 5.72075 19.3244 5.65077 18.9916 5.89731C18.6587 6.14384 18.5888 6.61353 18.8353 6.94639C19.8815 8.35894 20.5 10.1062 20.5 12C20.5 13.5311 20.0958 14.9663 19.3881 16.2064Z";
                        icon-filled: true;
                        icon-stroked: false;
                        checkable: true;
                        checked: root.system-audio;
                        enabled: !root.recording-busy
                            && root.output-format == 0
                            && root.system-audio-available;
                        clicked => {
                            root.system-audio = !root.system-audio;
                            root.system-audio-changed(root.system-audio);
                        }
                    }

                    microphone-action := CapsuleAction {
                        label: @tr("麦克风");
                        accessible-name: root.microphone
                            ? @tr("麦克风：开启") : @tr("麦克风：关闭");
                        icon-path: root.microphone
                            ? "M18.25 11C18.6297 11 18.9435 11.2822 18.9932 11.6482L19 11.75V12.25C19 15.8094 16.245 18.7254 12.751 18.9817L12.75 21.25C12.75 21.6642 12.4142 22 12 22C11.6203 22 11.3065 21.7178 11.2568 21.3518L11.25 21.25L11.25 18.9818C7.83323 18.7316 5.12283 15.938 5.00406 12.4863L5 12.25V11.75C5 11.3358 5.33579 11 5.75 11C6.1297 11 6.44349 11.2822 6.49315 11.6482L6.5 11.75V12.25C6.5 15.077 8.73445 17.3821 11.5336 17.4956L11.75 17.5H12.25C15.077 17.5 17.3821 15.2656 17.4956 12.4664L17.5 12.25V11.75C17.5 11.3358 17.8358 11 18.25 11ZM12 2C14.2091 2 16 3.79086 16 6V12C16 14.2091 14.2091 16 12 16C9.79086 16 8 14.2091 8 12V6C8 3.79086 9.79086 2 12 2ZM12 3.5C10.6193 3.5 9.5 4.61929 9.5 6V12C9.5 13.3807 10.6193 14.5 12 14.5C13.3807 14.5 14.5 13.3807 14.5 12V6C14.5 4.61929 13.3807 3.5 12 3.5Z"
                            : "M3.28034 2.21968C2.98745 1.92678 2.51257 1.92677 2.21968 2.21966C1.92678 2.51255 1.92677 2.98743 2.21966 3.28032L8 9.06078V12C8 14.2091 9.79086 16 12 16C12.8335 16 13.6074 15.7451 14.2481 15.309L15.394 16.4549C14.5176 17.1112 13.4292 17.5 12.25 17.5H11.75L11.5336 17.4956C8.73445 17.3821 6.5 15.077 6.5 12.25V11.75L6.49315 11.6482C6.44349 11.2822 6.1297 11 5.75 11C5.33579 11 5 11.3358 5 11.75V12.25L5.00406 12.4863C5.12283 15.938 7.83323 18.7316 11.25 18.9818L11.25 21.25L11.2568 21.3518C11.3065 21.7178 11.6203 22 12 22C12.4142 22 12.75 21.6642 12.75 21.25L12.751 18.9817C14.15 18.8791 15.4305 18.35 16.4631 17.5241L20.7194 21.7805C21.0123 22.0734 21.4872 22.0734 21.7801 21.7805C22.073 21.4876 22.073 21.0127 21.7801 20.7198L3.28034 2.21968ZM13.1562 14.2171C12.8105 14.3978 12.4172 14.5 12 14.5C10.6193 14.5 9.5 13.3807 9.5 12V10.5608L13.1562 14.2171ZM14.5 6V11.3182L15.9301 12.7483C15.976 12.5059 16 12.2558 16 12V6C16 3.79086 14.2091 2 12 2C10.1521 2 8.59692 3.25302 8.13768 4.95575L9.5 6.3181V6C9.5 4.61929 10.6193 3.5 12 3.5C13.3807 3.5 14.5 4.61929 14.5 6ZM17.1962 14.0144L18.3421 15.1604C18.7638 14.2791 19 13.2921 19 12.25V11.75L18.9932 11.6482C18.9435 11.2822 18.6297 11 18.25 11C17.8358 11 17.5 11.3358 17.5 11.75V12.25L17.4956 12.4664C17.4737 13.0075 17.3698 13.5276 17.1962 14.0144Z";
                        icon-filled: true;
                        icon-stroked: false;
                        checkable: true;
                        checked: root.microphone;
                        enabled: !root.recording-busy
                            && root.output-format == 0
                            && root.microphone-available;
                        clicked => {
                            root.microphone = !root.microphone;
                            root.microphone-changed(root.microphone);
                        }
                    }
                }
            }

            record-action := CapsuleAction {
                label: root.recording-busy ? @tr("停止") : @tr("开始");
                footer-text: root.recording-state == 1
                    ? "REC"
                    : root.recording-state == 2
                        ? @tr("暂停")
                        : root.recording-state == 3 ? @tr("准备") : "";
                footer-color: root.recording-state == 2 ? #f1b66f : #ff858e;
                accessible-name: root.recording-busy
                    ? @tr("停止录制")
                        + (root.stop-shortcut-label == "" ? "" : " (" + root.stop-shortcut-label + ")")
                    : @tr("开始录制")
                        + (root.start-shortcut-label == "" ? "" : " (" + root.start-shortcut-label + ")");
                icon-path: root.recording-busy ? "M7 7 H17 V17 H7 Z" : "M8 5 L19 12 L8 19 Z";
                icon-filled: true;
                danger: true;
                clicked => {
                    if root.recording-busy { root.stop-recording(); }
                    else { root.start-recording(); }
                }
            }

            Rectangle {
                width: 27px;
                height: 57px;
                background: transparent;
            }
        }
    }

    context-menu := ContextMenuArea {
        width: parent.width;
        height: parent.height;

        Menu {
            MenuItem {
                title: @tr("开始录制")
                    + (root.start-shortcut-label == "" ? "" : "    " + root.start-shortcut-label);
                enabled: !root.recording-busy;
                activated => { root.start-recording(); }
            }
            MenuItem {
                title: (root.recording-state == 2 ? @tr("继续录制") : @tr("暂停录制"))
                    + (root.pause-shortcut-label == "" ? "" : "    " + root.pause-shortcut-label);
                enabled: root.recording-active;
                activated => { root.pause-recording(); }
            }
            MenuItem {
                title: @tr("停止录制")
                    + (root.stop-shortcut-label == "" ? "" : "    " + root.stop-shortcut-label);
                enabled: root.recording-busy;
                activated => { root.stop-recording(); }
            }
            MenuSeparator {}
            MenuItem {
                title: @tr("首选项...");
                activated => { root.open-preferences(); }
            }
            MenuSeparator {}
            MenuItem {
                title: @tr("打开保存目录");
                activated => { root.open-output-directory(); }
            }
            MenuSeparator {}
            MenuItem {
                title: @tr("退出");
                activated => { root.quit-application(); }
            }
        }
    }
}
