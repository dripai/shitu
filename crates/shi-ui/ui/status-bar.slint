import { Palette } from "std-widgets.slint";

export component StatusBar inherits Rectangle {
    in property <string> status-text: @tr("就绪");
    in property <int> status-level: 0;
    in property <brush> foreground-color: Palette.foreground;
    in property <brush> muted-color: Palette.alternate-foreground;
    in property <color> success-color: #238636;
    in property <color> error-color: #cf222e;
    in property <brush> divider-color: Palette.border;

    height: 26px;
    background: Palette.alternate-background;

    Rectangle { height: 1px; width: 100%; background: root.divider-color; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 6px;

        status-indicator := Rectangle {
            width: 10px;

            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 10px;
                height: 10px;
                border-radius: self.width / 2;
                background: root.status-level == 2 ? root.error-color
                    : root.status-level == 1 ? root.success-color : root.muted-color;
            }
        }
        Text {
            text: root.status-text;
            color: root.status-level == 2 ? root.error-color : root.foreground-color;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    Tooltip { text: @markdown("\{root.status-text}"); }
}
